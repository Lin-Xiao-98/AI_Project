# 复制此文件为 .env，再填写自己的 OpenAI API Key。
OPENAI_API_KEY=your_api_key_here

# 默认聊天档位：fast、balanced 或 deep。
ASSISTANT_MODE=fast

# 记忆判断固定使用低成本、支持严格结构输出的模型。
OPENAI_MEMORY_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-6-luna
WECOM_WEBHOOK_URL=

# 官方企业微信智能机器人长连接。默认关闭；启用时三项都必须填写。
WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_ALLOWED_USER_IDS=

# smart 只在疑似长期信息时调用记忆模型；always 每条调用；off 完全关闭。
MEMORY_ANALYSIS_MODE=smart

# 控制上下文和单次回复长度，兼顾效果与额度。
MAX_HISTORY_MESSAGES=24
MAX_COMPLETION_TOKENS=1600
